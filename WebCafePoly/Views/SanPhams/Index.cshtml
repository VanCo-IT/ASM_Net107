@model IEnumerable<WebCafePoly.Models.SanPham>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="product-admin-page">

    <!-- HEADER -->
    <div class="page-header">
        <div class="page-header-content">
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Quản trị</a>
                <span class="separator"><i class="bi bi-chevron-right"></i></span>
                <span class="current">Sản phẩm</span>
            </nav>
            <h1>Quản lý sản phẩm</h1>
            <p>Quản lý danh sách đồ uống và sản phẩm của quán.</p>
        </div>
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                Thêm sản phẩm
            </a>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar">
        <div class="toolbar-left">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text"
                       id="txtTimKiem"
                       class="form-control"
                       placeholder="Tìm kiếm theo tên sản phẩm..." />
            </div>
        </div>
        <div class="toolbar-right">
            <div class="toolbar-count">
                <span>Danh sách sản phẩm</span>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div id="ketQuaTimKiem">
        <partial name="_PhanBangSanPham" model="Model" />
    </div>

</div>

@section Scripts
{
    <script>
        document.getElementById("txtTimKiem").addEventListener("keyup", function () {
            let tuKhoa = this.value;
            fetch("/SanPhams/TimKiem?timkiem=" + encodeURIComponent(tuKhoa))
                .then(response => response.text())
                .then(html => {
                    document.getElementById("ketQuaTimKiem").innerHTML = html;
                });
        });
    </script>
}