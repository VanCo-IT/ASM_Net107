@model IEnumerable<WebCafePoly.Models.SanPham>

<div class="table-card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Loại</th>
                        <th>Hình ảnh</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <!-- PRODUCT -->
                            <td>
                                <div class="name-cell">
                                    <div class="avatar">
                                        @if (!string.IsNullOrEmpty(item.HinhAnh))
                                        {
                                            <img src="~/images/products/@item.HinhAnh" alt="@item.TenSanPham" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-cup-hot-fill"></i>
                                        }
                                    </div>
                                    <div class="name-info">
                                        <strong>@item.TenSanPham</strong>
                                        <small>@item.MaSanPham</small>
                                    </div>
                                </div>
                            </td>

                            <!-- PRICE -->
                            <td>
                                <span class="price-cell">@item.DonGia.ToString("N0") đ</span>
                            </td>

                            <!-- CATEGORY -->
                            <td>
                                <span class="category-badge">@item.MaLoaiNavigation?.TenLoai</span>
                            </td>

                            <!-- IMAGE -->
                            <td>
                                @if (!string.IsNullOrEmpty(item.HinhAnh))
                                {
                                    <img src="~/images/products/@item.HinhAnh"
                                         alt="@item.TenSanPham"
                                         class="table-image" />
                                }
                                else
                                {
                                    <span class="no-image">Không có ảnh</span>
                                }
                            </td>

                            <!-- STATUS -->
                            <td>
                                @if (item.TrangThai)
                                {
                                    <span class="status-badge status-active">
                                        <span class="dot"></span>
                                        Đang bán
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        <span class="dot"></span>
                                        Ngừng bán
                                    </span>
                                }
                            </td>

                            <!-- ACTIONS -->
                            <td>
                                <div class="actions-cell">
                                    <a asp-action="Details"
                                       asp-route-masanpham="@item.MaSanPham"
                                       class="action-btn action-view"
                                       title="Xem chi tiết">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Edit"
                                       asp-route-masanpham="@item.MaSanPham"
                                       class="action-btn action-edit"
                                       title="Chỉnh sửa">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Delete"
                                       asp-route-masanpham="@item.MaSanPham"
                                       class="action-btn action-delete"
                                       title="Xóa sản phẩm">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-box"></i>
            <h4>Chưa có sản phẩm</h4>
            <p>Hãy thêm sản phẩm đầu tiên để bắt đầu quản lý.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                Thêm sản phẩm
            </a>
        </div>
    }
</div>