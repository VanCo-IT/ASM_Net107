@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Trang khách hàng";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center">
                <div class="auth-icon">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <h1 class="mt-3">Xin chào, @ViewBag.HoTen!</h1>
                <p class="text-muted mt-2">Bạn đã đăng nhập thành công vào tài khoản khách hàng.</p>
                
                <div class="d-flex gap-3 justify-content-center mt-4 flex-wrap">
                    <a asp-action="GioHang" class="btn btn-success">
                        <i class="bi bi-cart3"></i>
                        Gi�� hàng
                    </a>
                    <a asp-action="LichSuDonHang" class="btn btn-outline">
                        <i class="bi bi-clock-history"></i>
                        Lịch sử đơn hàng
                    </a>
                    <a asp-action="HoSoKhachHang" class="btn btn-outline">
                        <i class="bi bi-person"></i>
                        Hồ sơ cá nhân
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>