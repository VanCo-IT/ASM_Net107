@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Trang khách hàng";
}

<section class="profile-page">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="text-center">
                    <div class="vintage-card vintage-card--paper p-5">
                        <div class="auth-icon">
                            <i class="bi bi-person-check-fill" aria-hidden="true"></i>
                        </div>
                        <h1 class="mt-3 text-vintage">Xin chào, @ViewBag.HoTen!</h1>
                        <p class="text-vintage--accent mt-2 mb-0">Bạn đã đăng nhập thành công vào tài khoản khách hàng.</p>

                        <div class="d-flex gap-3 justify-content-center mt-4 flex-wrap">
                            <a asp-action="GioHang" class="btn btn-vintage btn-vintage--primary">
                                <i class="bi bi-cart3" aria-hidden="true"></i>
                                Giỏ hàng
                            </a>
                            <a asp-action="LichSuDonHang" class="btn btn-vintage btn-vintage--outline">
                                <i class="bi bi-clock-history" aria-hidden="true"></i>
                                Lịch sử đơn hàng
                            </a>
                            <a asp-action="HoSoKhachHang" class="btn btn-vintage btn-vintage--outline">
                                <i class="bi bi-person" aria-hidden="true"></i>
                                Hồ sơ cá nhân
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
