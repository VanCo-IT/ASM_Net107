@model WebCafePoly.Models.KhachHang

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Hồ sơ khách hàng";
}

<section class="profile-page">
    <div class="container py-5">

        <div class="profile-header">
            <h1>Hồ sơ của tôi</h1>
            <p>Quản lý thông tin tài khoản</p>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-vintage alert-vintage--success">
                @ViewBag.ThongBao
            </div>
        }

        <div class="profile-card">
            <div class="profile-avatar">
                <i class="bi bi-person-circle"></i>
            </div>

            <form asp-action="HoSoKhachHang" method="post" class="profile-form form-vintage">
                <input asp-for="MaKhachHang" type="hidden" />
                <input asp-for="TrangThai" type="hidden" />

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="HoTen" class="form-label">Họ tên</label>
                        <input asp-for="HoTen" class="form-control" />
                        <span asp-validation-for="HoTen" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
                        <input asp-for="SoDienThoai" class="form-control" />
                        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
                        <input asp-for="DiaChi" class="form-control" />
                        <span asp-validation-for="DiaChi" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="MatKhau" class="form-label">Mật khẩu</label>
                    <div class="password-wrapper">
                        <input asp-for="MatKhau"
                               type="password"
                               value="@Model.MatKhau"
                               id="MatKhau"
                               class="form-control" />
                        <button type="button" class="password-toggle" onclick="togglePassword()">
                            <i class="bi bi-eye" id="passwordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>

                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           id="showPassword"
                           onclick="togglePassword()" />
                    <label class="form-check-label" for="showPassword">
                        Hiện mật khẩu
                    </label>
                </div>

                <button type="submit" class="btn btn-vintage btn-vintage--primary profile-submit">
                    <i class="bi bi-check-circle" aria-hidden="true"></i>
                    Cập nhật thông tin
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function togglePassword() {
            var input = document.getElementById("MatKhau");
            var checkbox = document.getElementById("showPassword");
            var icon = document.getElementById("passwordIcon");

            if (input.type === "password") {
                input.type = "text";
                checkbox.checked = true;
                icon.className = "bi bi-eye-slash";
            } else {
                input.type = "password";
                checkbox.checked = false;
                icon.className = "bi bi-eye";
            }
        }
    </script>
}