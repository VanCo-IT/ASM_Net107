@model IEnumerable<WebCafePoly.Models.ChiTietPhieu>

<div class="vintage-card vintage-card--paper p-4">
    <table class="table table-vintage align-middle mb-0">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaSanPhamNavigation.TenSanPham</td>
                    <td>@item.DonGia.ToString("N0") VNĐ</td>
                    <td>@item.SoLuong</td>
                    <td><strong>@((item.DonGia * item.SoLuong).ToString("N0")) VNĐ</strong></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="summary-total mt-4">
        <span>Tổng tiền</span>
        <span>@Model.Sum(x => x.DonGia * x.SoLuong).ToString("N0") VNĐ</span>
    </div>
</div>
