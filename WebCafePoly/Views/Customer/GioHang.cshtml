@model List<WebCafePoly.Models.GioHang>

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Gi�� hàng";
}

<section class="cart-page">
    <div class="container py-5">

        <div class="cart-header">
            <h1>Gi�� hàng</h1>
            <p>Kiểm tra món trước khi thanh toán</p>
        </div>

        @if (!Model.Any())
        {
            <div class="cart-empty">
                <i class="bi bi-cart-x"></i>
                <h3>Gi�� hàng đang trống</h3>
                <p>Hãy chọn món bạn muốn thưởng thức.</p>
                <a asp-controller="Guest"
                   asp-action="Index"
                   class="btn btn-success">
                    <i class="bi bi-cup-hot"></i>
                    Xem thực đơn
                </a>
            </div>
        }
        else
        {
            <div class="cart-content">
                <div class="cart-items">
                    <div class="table-responsive">
                        <table class="table cart-table align-middle">
                            <thead>
                                <tr>
                                    <th>Tên món</th>
                                    <th>Đơn giá</th>
                                    <th>Số lượng</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="cart-product">
                                                <img src="~/images/products/@item.HinhAnh"
                                                     alt="@item.TenSanPham"
                                                     class="cart-product-image" />
                                                <div class="cart-product-info">
                                                    <h4>@item.TenSanPham</h4>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="cart-price">@item.DonGia.ToString("N0") VNĐ</span>
                                        </td>
                                        <td>
                                            <div class="quantity-control">
                                                <a asp-action="GiamSoLuong"
                                                   asp-route-id="@item.MaSanPham"
                                                   class="quantity-btn minus">
                                                    <i class="bi bi-dash"></i>
                                                </a>
                                                <span class="quantity-value">@item.SoLuong</span>
                                                <a asp-action="TangSoLuong"
                                                   asp-route-id="@item.MaSanPham"
                                                   class="quantity-btn plus">
                                                    <i class="bi bi-plus"></i>
                                                </a>
                                            </div>
                                        </td>
                                        <td>
                                            <strong class="cart-subtotal">
                                                @item.ThanhTien.ToString("N0") VNĐ
                                            </strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="cart-summary">
                    <h3>Tóm tắt đơn hàng</h3>
                    <div class="summary-row">
                        <span class="label">Tạm tính</span>
                        <span class="value">@Model.Sum(x => x.ThanhTien).ToString("N0") VNĐ</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Phí vận chuyển</span>
                        <span class="value">Miễn phí</span>
                    </div>
                    <div class="summary-total">
                        <span>Tổng cộng</span>
                        <span>@Model.Sum(x => x.ThanhTien).ToString("N0") VNĐ</span>
                    </div>
                    <a asp-action="ThanhToan" class="btn btn-success checkout-btn">
                        <i class="bi bi-credit-card"></i>
                        Thanh toán
                    </a>
                </div>
            </div>
        }
    </div>
</section>