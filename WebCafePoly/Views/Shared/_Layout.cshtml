<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - WebCafePoly</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebCafePoly.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body class="admin-layout">

    <a href="#main-content" class="skip-link">Chuyển đến nội dung chính</a>

    <!-- ADMIN HEADER -->
    <header class="admin-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-4">

                <!-- LOGO -->
                <a class="admin-logo"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="logo-icon"><i class="bi bi-cup-hot-fill"></i></span>
                    <span>WebCafePoly</span>
                </a>

                <!-- MOBILE BUTTON -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#adminNavbar"
                        aria-controls="adminNavbar"
                        aria-expanded="false"
                        aria-label="Mở menu">
                    <i class="bi bi-list"></i>
                </button>

                <div class="collapse navbar-collapse admin-nav" id="adminNavbar">

                    <!-- MENU -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-fill"></i>
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="SanPhams"
                               asp-action="Index">
                                <i class="bi bi-cup-hot-fill"></i>
                                Sản phẩm
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="LoaiSanPhams"
                               asp-action="Index">
                                <i class="bi bi-grid-fill"></i>
                                Loại sản phẩm
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="KhachHangs"
                               asp-action="Index">
                                <i class="bi bi-people-fill"></i>
                                Khách hàng
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="NhanViens"
                               asp-action="Index">
                                <i class="bi bi-person-badge-fill"></i>
                                Nhân viên
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="PhieuBanHangs"
                               asp-action="Index">
                                <i class="bi bi-receipt-fill"></i>
                                Phiếu bán
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="ChiTietPhieus"
                               asp-action="Index">
                                <i class="bi bi-list-task"></i>
                                Chi tiết phiếu
                            </a>
                        </li>

                    </ul>

                    <!-- ACCOUNT -->
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("HoTen") != null)
                        {
                            <li class="nav-item dropdown account-dropdown">
                                <a class="account-button dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <span class="account-avatar"><i class="bi bi-person-fill"></i></span>
                                    <span class="account-name">@Context.Session.GetString("HoTen")</span>
                                    <i class="bi bi-chevron-down"></i>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end show">
                                    <li>
                                        <h6 class="dropdown-header">Quản trị viên / Nhân viên</h6>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Home"
                                           asp-action="Index">
                                            <i class="bi bi-speedometer2"></i>
                                            Trang quản trị
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item logout-item"
                                           asp-controller="DangNhap"
                                           asp-action="DangXuat">
                                            <i class="bi bi-box-arrow-right"></i>
                                            Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (Context.Session.GetString("HoTenKhachHang") != null)
                        {
                            <li class="nav-item dropdown account-dropdown">
                                <a class="account-button dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <span class="account-avatar"><i class="bi bi-person-fill"></i></span>
                                    <span class="account-name">@Context.Session.GetString("HoTenKhachHang")</span>
                                    <i class="bi bi-chevron-down"></i>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end show">
                                    <li>
                                        <h6 class="dropdown-header">Tài khoản khách hàng</h6>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Customer"
                                           asp-action="HoSoKhachHang">
                                            <i class="bi bi-person"></i>
                                            Hồ sơ
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Customer"
                                           asp-action="GioHang">
                                            <i class="bi bi-cart3"></i>
                                            Giỏ hàng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Customer"
                                           asp-action="LichSuDonHang">
                                            <i class="bi bi-clock-history"></i>
                                            Lịch sử đơn hàng
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item logout-item"
                                           asp-controller="GuestAccount"
                                           asp-action="DangXuat">
                                            <i class="bi bi-box-arrow-right"></i>
                                            Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown account-dropdown">
                                <a class="account-button dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <span class="account-avatar"><i class="bi bi-person-fill"></i></span>
                                    Tài khoản
                                    <i class="bi bi-chevron-down"></i>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end show">
                                    <li>
                                        <h6 class="dropdown-header">Khách hàng</h6>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="GuestAccount"
                                           asp-action="DangKy">
                                            <i class="bi bi-person-plus"></i>
                                            Đăng ký khách hàng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="GuestAccount"
                                           asp-action="DangNhap">
                                            <i class="bi bi-box-arrow-in-right"></i>
                                            Đăng nhập khách hàng
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <h6 class="dropdown-header">Nhân viên</h6>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="DangNhap"
                                           asp-action="Login">
                                            <i class="bi bi-person-badge"></i>
                                            Đăng nhập nhân viên
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>


    <!-- MAIN -->
    <main id="main-content" class="admin-main" role="main">

        <div class="container-fluid px-4 py-4">

            @RenderBody()

        </div>

    </main>


    <!-- FOOTER -->
    <footer class="admin-footer">
        <div class="container-fluid px-4">
            <div class="footer-content">
                <span>© 2026 WebCafePoly</span>
                <span>Hệ thống quản lý quán cafe</span>
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>