@model IEnumerable<WebCafePoly.Models.ChiTietPhieu>

@{
    ViewData["Title"] = "Quản lý chi tiết phiếu";
}

<div class="product-admin-page">

    <!-- HEADER -->
    <div class="page-header">
        <div class="page-header-content">
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Quản trị</a>
                <span class="separator"><i class="bi bi-chevron-right"></i></span>
                <span class="current">Chi tiết phiếu</span>
            </nav>
            <h1>Quản lý chi tiết phiếu</h1>
            <p>Quản lý chi tiết các món trong phiếu bán.</p>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar">
        <div class="toolbar-left">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text"
                       id="txtTimKiem"
                       class="form-control"
                       placeholder="Tìm kiếm theo mã phiếu..." />
            </div>
        </div>
        <div class="toolbar-right">
            <div class="toolbar-count">
                <span>Danh sách chi tiết phiếu</span>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div id="ketQuaTimKiem">
        @if (Model.Any())
        {
            <div class="table-card">
                <div class="table-responsive">
                    <table class="table data-table">
                        <thead>
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var thanhTien = item.DonGia * item.SoLuong;
                                <tr>
                                    <td>
                                        <strong class="text-primary">@item.MaPhieu</strong>
                                    </td>
                                    <td>
                                        <div class="name-cell" style="min-width: auto;">
                                            <div class="avatar">
                                                <i class="bi bi-cup-hot-fill"></i>
                                            </div>
                                            <div class="name-info">
                                                <strong>@item.MaSanPhamNavigation?.TenSanPham</strong>
                                                <small>@item.MaSanPham</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.SoLuong</td>
                                    <td><span class="price-cell">@item.DonGia.ToString("N0") đ</span></td>
                                    <td><strong class="text-success">@thanhTien.ToString("N0") đ</strong></td>
                                    <td>
                                        <div class="actions-cell">
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="action-btn action-view"
                                               title="Xem chi tiết">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="action-btn action-edit"
                                               title="Chỉnh sửa">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="action-btn action-delete"
                                               title="Xóa chi tiết">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-list-task"></i>
                <h4>Chưa có chi tiết phiếu</h4>
                <p>Chi tiết phiếu sẽ hiển thị khi có phiếu bán hàng.</p>
            </div>
        }
    </div>

</div>

@section Scripts
{
    <script>
        document.getElementById("txtTimKiem")?.addEventListener("keyup", function () {
            let tuKhoa = this.value;
            fetch("/ChiTietPhieus/TimKiem?timkiem=" + encodeURIComponent(tuKhoa))
                .then(response => response.text())
                .then(html => {
                    document.getElementById("ketQuaTimKiem").innerHTML = html;
                });
        });
    </script>
}