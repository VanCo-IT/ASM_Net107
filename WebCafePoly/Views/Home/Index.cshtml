@{
    ViewData["Title"] = "Trang quản trị";
}

<div class="admin-dashboard">

    <!-- HEADER -->
    <div class="dashboard-header">
        <div>
            <h1>Trang quản trị</h1>
            <p>Quản lý và theo dõi hoạt động của WebCafePoly</p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-cup-hot-fill"></i>
            WebCafePoly
        </div>
    </div>


    <!-- STATISTICS -->
    <div class="stats-grid">

        <!-- SẢN PHẨM -->
        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="bi bi-cup-hot-fill"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Sản phẩm</span>
                <strong class="stat-value">@ViewBag.SoSanPham</strong>
            </div>
            <a asp-controller="SanPhams"
               asp-action="Index"
               class="stat-link">
                Quản lý <i class="bi bi-arrow-right"></i>
            </a>
        </div>


        <!-- KHÁCH HÀNG -->
        <div class="stat-card">
            <div class="stat-icon success">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Khách hàng</span>
                <strong class="stat-value">@ViewBag.SoKhachHang</strong>
            </div>
            <a asp-controller="KhachHangs"
               asp-action="Index"
               class="stat-link">
                Quản lý <i class="bi bi-arrow-right"></i>
            </a>
        </div>


        <!-- NHÂN VIÊN -->
        <div class="stat-card">
            <div class="stat-icon warning">
                <i class="bi bi-person-badge-fill"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Nhân viên</span>
                <strong class="stat-value">@ViewBag.SoNhanVien</strong>
            </div>
            <a asp-controller="NhanViens"
               asp-action="Index"
               class="stat-link">
                Quản lý <i class="bi bi-arrow-right"></i>
            </a>
        </div>


        <!-- PHIẾU BÁN -->
        <div class="stat-card">
            <div class="stat-icon info">
                <i class="bi bi-receipt-fill"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Phiếu bán</span>
                <strong class="stat-value">@ViewBag.SoPhieuBan</strong>
            </div>
            <a asp-controller="PhieuBanHangs"
               asp-action="Index"
               class="stat-link">
                Quản lý <i class="bi bi-arrow-right"></i>
            </a>
        </div>

    </div>


    <!-- QUICK ACTIONS -->
    <div class="quick-actions">
        <div class="section-header">
            <div>
                <h3>Thao tác nhanh</h3>
                <p>Truy cập nhanh các chức năng quản trị</p>
            </div>
        </div>

        <div class="actions-grid">
            <a asp-controller="SanPhams"
               asp-action="Create"
               class="action-card">
                <span class="action-icon"><i class="bi bi-plus-lg"></i></span>
                <span class="action-text">
                    <strong>Thêm sản phẩm</strong>
                    <small>Tạo sản phẩm mới</small>
                </span>
            </a>

            <a asp-controller="LoaiSanPhams"
               asp-action="Create"
               class="action-card">
                <span class="action-icon"><i class="bi bi-plus-lg"></i></span>
                <span class="action-text">
                    <strong>Thêm loại sản phẩm</strong>
                    <small>Tạo loại mới</small>
                </span>
            </a>

            <a asp-controller="KhachHangs"
               asp-action="Create"
               class="action-card">
                <span class="action-icon"><i class="bi bi-plus-lg"></i></span>
                <span class="action-text">
                    <strong>Thêm khách hàng</strong>
                    <small>Tạo khách hàng mới</small>
                </span>
            </a>

            <a asp-controller="NhanViens"
               asp-action="Create"
               class="action-card">
                <span class="action-icon"><i class="bi bi-plus-lg"></i></span>
                <span class="action-text">
                    <strong>Thêm nhân viên</strong>
                    <small>Tạo nhân viên mới</small>
                </span>
            </a>
        </div>
    </div>


    <!-- INFORMATION -->
    <div class="info-card">
        <div class="info-icon">
            <i class="bi bi-cup-hot-fill"></i>
        </div>
        <div class="info-content">
            <h4>WebCafePoly Admin</h4>
            <p>Hệ thống quản lý quán cafe — quản lý sản phẩm, khách hàng, nhân viên và phiếu bán hàng.</p>
        </div>
    </div>

</div>