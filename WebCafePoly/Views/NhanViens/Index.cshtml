@model IEnumerable<WebCafePoly.Models.NhanVien>

@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="product-admin-page">

    <!-- HEADER -->
    <div class="page-header">
        <div class="page-header-content">
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Quản trị</a>
                <span class="separator"><i class="bi bi-chevron-right"></i></span>
                <span class="current">Nhân viên</span>
            </nav>
            <h1>Quản lý nhân viên</h1>
            <p>Quản lý danh sách nhân viên của quán.</p>
        </div>
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                Thêm nhân viên
            </a>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar">
        <div class="toolbar-left">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text"
                       id="txtTimKiem"
                       class="form-control"
                       placeholder="Tìm kiếm theo tên, email..." />
            </div>
        </div>
        <div class="toolbar-right">
            <div class="toolbar-count">
                <span>Danh sách nhân viên</span>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div id="ketQuaTimKiem">
        @if (Model.Any())
        {
            <div class="table-card">
                <div class="table-responsive">
                    <table class="table data-table">
                        <thead>
                            <tr>
                                <th>Nhân viên</th>
                                <th>Email</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="name-cell">
                                            <div class="avatar">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <div class="name-info">
                                                <strong>@item.HoTen</strong>
                                                <small>@item.MaNhanVien</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.Email</td>
                                    <td>
                                        @if (item.VaiTro)
                                        {
                                            <span class="role-badge role-admin">Quản trị</span>
                                        }
                                        else
                                        {
                                            <span class="role-badge role-staff">Nhân viên</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.TrangThai)
                                        {
                                            <span class="status-badge status-active">
                                                <span class="dot"></span>
                                                Đang làm
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                <span class="dot"></span>
                                                Nghỉ việc
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="actions-cell">
                                            <a asp-action="Details"
                                               asp-route-manhanvien="@item.MaNhanVien"
                                               class="action-btn action-view"
                                               title="Xem chi tiết">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit"
                                               asp-route-manhanvien="@item.MaNhanVien"
                                               class="action-btn action-edit"
                                               title="Chỉnh sửa">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-manhanvien="@item.MaNhanVien"
                                               class="action-btn action-delete"
                                               title="Xóa nhân viên">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-person-badge"></i>
                <h4>Chưa có nhân viên</h4>
                <p>Hãy thêm nhân viên đầu tiên.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Thêm nhân viên
                </a>
            </div>
        }
    </div>

</div>

@section Scripts
{
    <script>
        document.getElementById("txtTimKiem")?.addEventListener("keyup", function () {
            let tuKhoa = this.value;
            fetch("/NhanViens/TimKiem?timkiem=" + encodeURIComponent(tuKhoa))
                .then(response => response.text())
                .then(html => {
                    document.getElementById("ketQuaTimKiem").innerHTML = html;
                });
        });
    </script>
}