@model IEnumerable<WebCafePoly.Models.PhieuBanHang>

@{
    ViewData["Title"] = "Quản lý phiếu bán";
}

<div class="product-admin-page">

    <!-- HEADER -->
    <div class="page-header">
        <div class="page-header-content">
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Quản trị</a>
                <span class="separator"><i class="bi bi-chevron-right"></i></span>
                <span class="current">Phiếu bán</span>
            </nav>
            <h1>Quản lý phiếu bán</h1>
            <p>Quản lý danh sách phiếu bán hàng.</p>
        </div>
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                Tạo phiếu
            </a>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar">
        <div class="toolbar-left">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text"
                       id="txtTimKiem"
                       class="form-control"
                       placeholder="Tìm kiếm theo mã phiếu..." />
            </div>
        </div>
        <div class="toolbar-right">
            <div class="toolbar-count">
                <span>Danh sách phiếu bán</span>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div id="ketQuaTimKiem">
        @if (Model.Any())
        {
            <div class="table-card">
                <div class="table-responsive">
                    <table class="table data-table">
                        <thead>
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Nhân viên</th>
                                <th>Khách hàng</th>
                                <th>Ngày tạo</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-primary">@item.MaPhieu</strong>
                                    </td>
                                    <td>
                                        <div class="name-cell" style="min-width: auto;">
                                            <div class="avatar">
                                                <i class="bi bi-person-badge-fill"></i>
                                            </div>
                                            <div class="name-info">
                                                <strong>@item.MaNhanVienNavigation?.HoTen</strong>
                                                <small>@item.MaNhanVien</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.MaKhachHang != null)
                                        {
                                            <div class="name-cell" style="min-width: auto;">
                                                <div class="avatar">
                                                    <i class="bi bi-person-fill"></i>
                                                </div>
                                                <div class="name-info">
                                                    <strong>@item.MaKhachHangNavigation?.HoTen</strong>
                                                    <small>@item.MaKhachHang</small>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Khách vãng lai</span>
                                        }
                                    </td>
                                    <td>@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (item.TrangThai)
                                        {
                                            <span class="status-badge status-active">
                                                <span class="dot"></span>
                                                Đã thanh toán
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-pending">
                                                <span class="dot"></span>
                                                Chưa thanh toán
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="actions-cell">
                                            <a asp-action="Details"
                                               asp-route-maphiban="@item.MaPhieu"
                                               class="action-btn action-view"
                                               title="Xem chi tiết">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit"
                                               asp-route-maphiban="@item.MaPhieu"
                                               class="action-btn action-edit"
                                               title="Chỉnh sửa">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-maphiban="@item.MaPhieu"
                                               class="action-btn action-delete"
                                               title="Xóa phiếu">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-receipt"></i>
                <h4>Chưa có phiếu bán</h4>
                <p>Hãy tạo phiếu bán đầu tiên.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Tạo phiếu bán
                </a>
            </div>
        }
    </div>

</div>

@section Scripts
{
    <script>
        document.getElementById("txtTimKiem")?.addEventListener("keyup", function () {
            let tuKhoa = this.value;
            fetch("/PhieuBanHangs/TimKiem?timkiem=" + encodeURIComponent(tuKhoa))
                .then(response => response.text())
                .then(html => {
                    document.getElementById("ketQuaTimKiem").innerHTML = html;
                });
        });
    </script>
}